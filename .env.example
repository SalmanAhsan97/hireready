# Copy to .env and fill in what you have. With no AI key the app runs in demo mode.

# AI model: Claude is used when set, otherwise Gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Job postings and LinkedIn profiles (optional; falls back to LinkedIn's public job page)
BRIGHTDATA_API_KEY=
APIFY_API_TOKEN=

# Storage for caches, history and usage limits (optional; falls back to local .cache/ files)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Access and limits for public deploys
HIREREADY_ACCESS_CODE=          # empty = everyone gets the full report; set = visitors get a free preview
HIREREADY_DAILY_LIMIT=15        # analyses + application kits per visitor per day (0 = off)
HIREREADY_PREVIEW_LIMIT=3       # free previews per visitor per day
HIREREADY_CHAT_LIMIT=40         # resume-chat messages per visitor per day
HIREREADY_CLIENT_SALT=          # random string used to hash visitor IPs
HIREREADY_CONTACT_EMAIL=        # shown on locked preview sections
